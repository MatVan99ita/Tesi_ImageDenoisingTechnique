\newcommand{\underlinebrace}[2]{%
\tikz[remember picture,baseline=(a.base)]{%
\node[inner sep=0pt] (a) {#1}; 
\draw[decorate,decoration={brace,mirror,amplitude=4pt}] (a.south west) -- (a.south east);
\node[below=4pt] at (a.south) {#2};
}%
}

